# Copy this file to .env and fill in your values.
# The bot and API server both load .env automatically via python-dotenv / dotenv.

# ── Database ──────────────────────────────────────────────────────────────────
# If you use docker-compose, the default value below works out of the box.
DATABASE_URL=postgresql://polymarket:polymarket@localhost:5432/polymarket

# ── Bot settings (optional overrides) ────────────────────────────────────────
# How often the pipeline runs (seconds). Default: 300 (5 min).
# POLL_INTERVAL_SECONDS=300

# ── Keep-alive server (Replit only) ──────────────────────────────────────────
# Set to "true" only on Replit to keep the dyno awake.
# Leave unset (or "false") when running locally.
# ENABLE_KEEPALIVE=false
# BOT_PORT=5001

# ── Discord alerts (optional) ────────────────────────────────────────────────
# Create a webhook in your Discord server: Channel settings → Integrations → Webhooks.
# Leave blank to disable alerts.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── API server ────────────────────────────────────────────────────────────────
# Port for the Express API server. Default: 8080.
# PORT=8080
